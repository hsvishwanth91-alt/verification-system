# APP_URL: The URL where this applet is hosted.
# Used for QR code public verification URLs and self-referential links.
APP_URL="MY_APP_URL"

# Optional server-side administrator credentials.
# Leave blank in local preview to use the first-run Admin Onboarding setup in the UI.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional database storage path override (defaults to ./data/certitrust.db)
DATABASE_PATH=
